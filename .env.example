# Set this to true only when the frontend is served by the same Render service as the API.
VITE_USE_SAME_ORIGIN_API="true"

# Render backend environment variables.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
FRONTEND_ORIGIN="https://your-vercel-project.vercel.app"
COURIER_PROVIDER="Perth Connect Delivery"
SENDER_POSTCODE="6000"
